# Copy to .env and fill in. .env is never committed (NFR-SEC-001).
# Read by Docker Compose (compose.yaml) and by the backend
# (backend/app/config.py). Values shown are placeholders or defaults.

# PostgreSQL: used by Compose to create the database and by the backend to connect
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=paperpilot
POSTGRES_USER=paperpilot
POSTGRES_PASSWORD=change-me-local-only

# GROBID: Compose publishes it on this port; the backend calls GROBID_URL
GROBID_PORT=8070
GROBID_URL=http://127.0.0.1:8070
# Phase 1 measured 1.4-11 s per paper; kept generous for larger papers
GROBID_TIMEOUT_SECONDS=120
# When GROBID answers 503 (all threads busy): retries and the wait between them
GROBID_BUSY_RETRIES=2
GROBID_BUSY_RETRY_SECONDS=5

# Local file storage; relative paths are inside the repository (data/ is git-ignored)
STORAGE_DIR=data/storage

# Upload limit in megabytes (OQ-005, answered in Phase 1)
MAX_UPLOAD_MB=50

# Longest question accepted for retrieval, in characters
MAX_QUERY_CHARS=2000

# LLM provider for answers (OQ-011, interim: LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5).
# Leave empty until the real-model run (P5-T12). Tests use a fake model.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# How long one model call may take, in seconds
LLM_TIMEOUT_SECONDS=60
# Upper bound on one model response, in tokens
LLM_MAX_OUTPUT_TOKENS=8000
# Extra attempts when a response breaks the answer format
LLM_MALFORMED_RETRIES=1

# Passages retrieved per question, and the budget for sending them to the model
ANSWER_TOP_K=5
MAX_CONTEXT_CHARS=16000
